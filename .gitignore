# macOS
.DS_Store

# secrets — never commit, this repo is public
.env
.env.*

# the panel's own notebook: what it did, so Annuler can take it back,
# and what it binned. Generated, never committed.
/.studio/

# build output (zola)
/public/

# zola writes resized images here during the build, then copies them into
# public/. Generated, never committed — `zola build` recreates them.
/static/processed_images/

# Source maps are a developer's convenience. The .js files themselves
# ARE committed — see "Why the compiled JS is in the repo" in README.
/static/js/*.js.map

# npm packages — restored by `npm ci` from package-lock.json
node_modules/

# ---------------------------------------------------------------
# CLIENT MATERIAL — never commit. This repository is PUBLIC.
#
# Briefs, proto decks, mood boards and design sources belong to the
# client and are not ours to publish. They live in _ref/, which is
# local only. If a client sends you a file, it goes in _ref/ first.
# ---------------------------------------------------------------
/_ref/

# design sources, wherever they land
*.pdf

# A DOSSIER IN content/ IS NOT A DESIGN SOURCE — it is the site.
# The engine shows PDFs now (a .pdf in a project folder is framed in its
# own page), and the deploy builds from a CHECKOUT of this repository. So
# an ignored dossier means a page that frames a file nobody ever
# committed: perfect on her machine, a 404 on the live site, and nothing
# anywhere saying so. tools/look.py fails if anything under content/ is
# ignored, so this cannot quietly come back.
!/content/**/*.pdf

# ...except the test kit's own PDFs, which tools/kit.py WRITES — they are
# not design sources and not anyone's but ours. Kept narrow to one
# directory on purpose: the rule above is the one that stops a client's
# brochure reaching a public repository, and it stays in force everywhere
# else. Without this line the kit shipped with its documents missing and
# nothing said so.
!/kit/documents/*.pdf
!/kit/wrong/*.pdf
*.ai
*.psd
*.sketch
*.fig
*.indd
*.afdesign
*.afphoto
